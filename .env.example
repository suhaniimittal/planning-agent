# --- Aetherion SDK (existing project config) ---
AETHERION_AGENT_TASK_QUEUE=aetherion-workflows-916cb4e2-156b-4a91-a57d-2502223b968f
AETHERION_TOOL_TASK_QUEUE=aetherion-activities-916cb4e2-156b-4a91-a57d-2502223b968f

# --- Neo4j (ingestion pipeline: stores Service nodes + CALLS edges) ---
NEO4J_USER=
NEO4J_PASSWORD=

# --- Embeddings ---
#
# Default: OpenAI directly. Fill this in for local dev / running as-is.
OPENAI_API_KEY=
#
# Aetherion AI Gateway — optional override. Leave both blank to use OpenAI
# above. Only fill these in once published on the platform (if the platform
# injects/requires them) — if both are set, the gateway takes priority.
AI_GATEWAY_URL=
AGENTS_GATEWAY_KEY=

# --- S3 (ingestion pipeline: source of truth for documentation.md files) ---
# RepoDocAI uploads to <bucket>/RepoDocAI/documentation/<repo>_<date>_documentation.md
S3_DOCS_BUCKET=
# AWS credentials are NOT set here — boto3 resolves them via its normal chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars, ~/.aws/credentials, or an
# IAM role if running on AWS infra). Only set AWS_* vars here if you're not
# already authenticated some other way.

# --- GitHub (optional — not used by the current S3-based ingestion path,
# kept for the push-to-repo step / as a fallback fetch path) ---
GITHUB_TOKEN=

# --- Local repo mode (local testing only) ---
# USE_LOCAL_REPO=true reads code from folders on this machine instead of
# downloading it from GitHub. Each run is a full re-ingest. Leave unset/false
# on the platform.
#
# LOCAL_REPO_PATH, comma-separated. Each entry is either:
#   /path/to/folder        -> service name = the folder's name
#   service-name=/path     -> any service name you like
# A single plain path is used for every service in the run.
# Example: LOCAL_REPO_PATH=/Users/me/reports-api,/Users/me/ui
USE_LOCAL_REPO=false
LOCAL_REPO_PATH=

# --- Confluence (optional — publishes each generated TDD as a new page.
# Leave CONFLUENCE_SPACE_KEY blank to skip publishing entirely; a failed
# call never blocks TDD generation itself.) ---
# Same Atlassian account/API token as Jira — different product, same auth.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# --- GitHub webhook listener (src/webhook_listener.py) ---
# Optional but strongly recommended once this is exposed publicly — the
# same secret you type into GitHub's own "Add webhook" form. Without it,
# the listener accepts any request with no way to tell it's really from
# GitHub. Fine to leave blank only for local testing against a throwaway
# URL (e.g. webhook.site) that nobody else knows about.
GITHUB_WEBHOOK_SECRET=
