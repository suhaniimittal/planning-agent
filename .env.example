# --- Aetherion SDK (existing project config) ---
AETHERION_AGENT_TASK_QUEUE=aetherion-workflows-916cb4e2-156b-4a91-a57d-2502223b968f
AETHERION_TOOL_TASK_QUEUE=aetherion-activities-916cb4e2-156b-4a91-a57d-2502223b968f

# --- The model ---
#
# Default: OpenAI directly. Fill this in for local dev / running as-is.
OPENAI_API_KEY=
#
# Aetherion AI Gateway — optional override. Leave both blank to use OpenAI
# above. Only fill these in once published on the platform (if the platform
# injects/requires them) — if both are set, the gateway takes priority.
AI_GATEWAY_URL=
AGENTS_GATEWAY_KEY=

# --- GitHub: the planner's only view of the code (REST API, no clone) ---
# Read-only token: Contents + Metadata, and Pull requests when PRs are listed.
GITHUB_TOKEN=
# Only for GitHub Enterprise Server, e.g. https://github.example.com/api/v3
GITHUB_API_BASE=

# --- The TDD flow (src/tdd/config.py); all optional, defaults shown ---
# May a source file's text be read into memory for one run? false = paths only.
ALLOW_CODE_READS=true
TDD_SCOUT=true
TDD_MAX_FILES_PER_SERVICE=20
TDD_MAX_FILES=40
TDD_MAX_CHARS=300000
TDD_MAP_FILES_PER_SERVICE=15
TDD_MAX_GITHUB_CALLS=150
TDD_MAX_CODE_SEARCHES=10

CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# 32 random bytes, base64 — encrypts the memory snapshots kept in Memsy. Generate:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CODE_GRAPH_KEY=

# Memsy (conversation memory): key from Memsy Settings > API Keys, Read + Write only
MEMSY_API_KEY=
MEMSY_BASE_URL=https://api.memsy.io/v1
