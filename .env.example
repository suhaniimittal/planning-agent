# --- Aetherion SDK (existing project config) ---
AETHERION_AGENT_TASK_QUEUE=aetherion-workflows-916cb4e2-156b-4a91-a57d-2502223b968f
AETHERION_TOOL_TASK_QUEUE=aetherion-activities-916cb4e2-156b-4a91-a57d-2502223b968f

# --- Neo4j (ingestion pipeline: stores Service nodes + CALLS edges) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Embeddings ---
#
# Default: OpenAI directly. Fill this in for local dev / running as-is.
OPENAI_API_KEY=
#
# Aetherion AI Gateway — optional override. Leave both blank to use OpenAI
# above. Only fill these in once published on the platform (if the platform
# injects/requires them) — if both are set, the gateway takes priority.
AI_GATEWAY_URL=
AGENTS_GATEWAY_KEY=

# --- S3 (ingestion pipeline: source of truth for documentation.md files) ---
# RepoDocAI uploads to <bucket>/RepoDocAI/documentation/<repo>_<date>_documentation.md
S3_DOCS_BUCKET=
# AWS credentials are NOT set here — boto3 resolves them via its normal chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars, ~/.aws/credentials, or an
# IAM role if running on AWS infra). Only set AWS_* vars here if you're not
# already authenticated some other way.

# --- GitHub (optional — not used by the current S3-based ingestion path,
# kept for the push-to-repo step / as a fallback fetch path) ---
GITHUB_TOKEN=
